{
  "name": "netease-music-downloader",
  "productName": "全平台音乐下载器",
  "version": "2.0.0",
  "description": "全平台音乐下载器（Electron GUI）：网易云、QQ音乐、酷狗、酷我、JOOX、咪咕 一处搜索，批量下载音频/歌词/封面，支持无损与跨平台补链。",
  "main": "main.js",
  "author": "dkvkvk",
  "license": "MIT",
  "keywords": [
    "electron",
    "music",
    "downloader",
    "netease",
    "kugou",
    "kuwo"
  ],
  "scripts": {
    "start": "electron .",
    "test": "node test/e2e.js",
    "icon": "node tools/make-icon.js",
    "dist": "node tools/make-icon.js && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.dkvkvk.all-music-downloader",
    "productName": "全平台音乐下载器",
    "copyright": "Copyright © 2026 dkvkvk",
    "directories": {
      "output": "out-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "downloader.js",
      "src/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AllMusicDownloader-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "全平台音乐下载器",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "全平台音乐下载器",
      "installerLanguages": [
        "zh_CN"
      ]
    }
  }
}
